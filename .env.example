# ============================================
# Aurora environment configuration example
# Copy this file to .env and adjust the values
# ============================================

# ------------------------------------------
# Required - TeslaMate database connection
# ------------------------------------------
# Database host (the server running TeslaMate's PostgreSQL)
TESLAMATE_DB_HOST=192.168.1.100

# Database port (default 5432)
TESLAMATE_DB_PORT=5432

# Database user
TESLAMATE_DB_USER=teslamate

# Database password
TESLAMATE_DB_PASSWORD=your_password_here

# Database name (default teslamate)
TESLAMATE_DB_NAME=teslamate

# SSL mode (disable / require)
TESLAMATE_DB_SSLMODE=disable

# ------------------------------------------
# Optional - service settings
# ------------------------------------------
# Port the web UI is served on (default 8080)
CYBERUI_PORT=8080

# Port the backend API is exposed on (default 8899, for debugging the API directly)
CYBERUI_API_PORT=8899

# Run mode (debug / release)
CYBERUI_SERVER_MODE=release

# Log level (debug / info / warn / error)
LOG_LEVEL=info

# Timezone
TZ=Europe/London

# ------------------------------------------
# Optional - API settings
# ------------------------------------------
# Default API address for the frontend (format: http://ip:port or https://domain)
# Only applied when the frontend is built; rebuild after changing it
VITE_API_BASE_URL=

# API key (used for API authentication; leave empty to disable authentication)
CYBERUI_API_KEY=

# ------------------------------------------
# Optional - mock data
# ------------------------------------------
# Serve mock data instead of connecting to the TeslaMate database (for demos or development)
# Default: false (use the real database); set to true to use local mock data
CYBERUI_MOCK_DATA=false
